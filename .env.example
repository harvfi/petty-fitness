# Gemini AI API Key (for workout/nutrition plan generation)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Email Configuration (for notifications)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
TRAINER_EMAIL=your_trainer_email@example.com

# Twilio SMS Configuration (OPTIONAL - for SMS notifications)
# If you want SMS notifications, get credentials from: https://www.twilio.com/console
# Otherwise, leave these as placeholders - email notifications will still work
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TRAINER_PHONE_NUMBER=your_trainer_phone_number

# IMPORTANT: For production on Vercel, you MUST set these environment variables
# in the Vercel dashboard under: Project Settings > Environment Variables
